FUNCTION sign_div_unsign_nqh (clock, denominator[31..0], numerator[31..0])
RETURNS ( quotient[31..0], remainder[31..0]);

--synthesis_resources = lut 652 reg 1040 
SUBDESIGN lpm_divide_m9t
( 
	aclr	:	input;
	clken	:	input;
	clock	:	input;
	denom[31..0]	:	input;
	numer[31..0]	:	input;
	quotient[31..0]	:	output;
	remain[31..0]	:	output;
) 
VARIABLE 
	divider : sign_div_unsign_nqh;
	const_node_aclr	: NODE;
	const_node_clken	: NODE;
	numer_tmp[31..0]	: WIRE;

BEGIN 
	divider.clock = clock;
	divider.denominator[] = denom[];
	divider.numerator[] = numer_tmp[];
	const_node_aclr = aclr;
	const_node_clken = clken;
	numer_tmp[] = numer[];
	quotient[] = divider.quotient[];
	remain[] = divider.remainder[];
END;
--VALID FILE
