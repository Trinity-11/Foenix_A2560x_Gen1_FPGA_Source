`timescale 1ns / 1ps
module INT_CONTROLLER (
input		wire				RST_i,
input		wire				CPU_Clk_i,

// CPU Bus Input
input		wire	[23:0]	CPU_A_i,
input		wire				CPU_RW_i,
input		wire				CPU_VPA_i,
input		wire				CPU_VDA_i,
input		wire				CPU_RDY_i,
input		wire	[7:0]		CPU_D_i,
output 	reg 	[7:0]		CPU_D_o,
input		wire				CS_Interrupt_Ctrl_i,

// Interrupt Sources Input
input		wire	[31:0]	LPC_INT_i,
input		wire	[5:0]		VICKY_INT_i,
input		wire				RTC_INT_i,
input		wire				OPL3_INT_i,
input		wire				OPN2_INT_i,
input		wire				OPM_INT_i,
input		wire				IDE_INT_i,
input		wire	[2:0]		BTX_INT_i,
input		wire				SD_INT_i,
input		wire				EXT_INT_i,		// I am not sure there is pull-up on this pin.
input		wire				Timer0_i,
input		wire				Timer1_i,
input		wire				Timer2_i,
input		wire				SD_Card_Insert_i,
input		wire				SuperIO_KB_i,
input		wire				SuperIO_MS_i,
input		wire				SuperIO_SUART_i,
input		wire				DAC_Playback_Done_i,
// Output IRQ
output	reg				IRQ_o,
output	wire				NMI_o
);





/*
Interrupt

LPC
00 - NC
01 - Keyboard
02 - NC
03 - COM2
04 - COM1
05 - MPU-401
06 - FDC
07 - Parallel Port


FOENIX C256
Interrupts

00 - SOF (VICKY) INT0
01 - LINE INT (VICKY) INT1
02 - TIMER0 (GAVIN)
03 - TIMER1 (GAVIN)
04 - TIMER2 (GAVIN)
05 - RTC INT (EXT_RTC)
06 - FDC (LPC)
07 - MOUSE (LPC)

08 - KEYBOARD (LPC)
09 - SPRITE COLLISION INT2 (VICKY)
0A - SPRITE COLLISION INT3 (VICKY)
0B - COM2 (LPC)
0C - COM1 (LPC)
0D - MPU-401 (LPC)
0E - PARALLEL PORT (LPC)
0F - SD_INT (SD_CARD_CONTROLLER)

10 - OPL3 (EXT_OPL3)
11 - BTX_INT0
12 - BTX_INT1
13 - SDMA_INT INT4 (GAVIN)
14 - VDMA_INT INt5 (GAVIN)
15 - BTX_INT2
16 - EXT_INT (EXT_EXPANSION)
17 - SDCARD INSERT

18 - OPN2
19 - OPM
1A - IDE_INTR
1B - TBD
1C - TBD
1D - TBD
1E - TBD
1F - TBD
*/

reg  [31:0] pol, edgen, pending, mask;   // register bank
reg  [31:0] lirq, dirq;                  // latched irqs, delayed latched irqs
reg  [31:0] Ena;
//

reg	[31:0] lirq0;
reg	[31:0] lirq1;






// latch interrupt inputs
always @(negedge CPU_Clk_i) begin
	
	lirq0 <= {  4'b0000, DAC_Playback_Done_i, 3'b000,
					SD_Card_Insert_i, EXT_INT_i, BTX_INT_i[2], VICKY_INT_i[5], VICKY_INT_i[4], BTX_INT_i[1], BTX_INT_i[0], OPL3_INT_i,	// H
					SD_INT_i, !LPT1_int_PulSe[3], !MPU_401_int_PulSe[3], !COM1_int_PulSe[3], !COM2_int_PulSe[3], VICKY_INT_i[3], VICKY_INT_i[2], !Keyboard_int_PulSe[3],	// M
					!Mouse_int_PulSe[3], !FDC_int_PulSe[3], RTC_INT_i, ~Timer2_i, ~Timer1_i, ~Timer0_i, VICKY_INT_i[1], VICKY_INT_i[0]}; 
	lirq1 <= lirq0;
	if ( lirq1 == lirq0) begin
		lirq <= 	lirq1;	
	end
end
 
/*
wire 	[71:0]		CS;
wire					Trigger_In;

//assign Trigger_In = Txf_Done;
//assign Trigger_In = CS_Txt_Background_Plt | CS_Txt_Foreground_Plt;
//assign Trigger_In = CS_SUPERIO_U_i & (CPU_D_i == 8'hF4) ? 1'b1 : 1'b0;
assign Trigger_In = SuperIO_KB_i;

assign CS[0] = SuperIO_KB_i;
assign CS[2:1] = Keyboard_int;
assign CS[6:3] = Keyboard_int_PulSe;
assign CS[15:8] = pending[15:8];
assign CS[63:32] = lirq;



