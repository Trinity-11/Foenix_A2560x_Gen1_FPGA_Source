module ProgramFlash (

input		wire				Clk_i,
input		wire				Rst_i,
input		wire				Erase_Flash_i,
input		wire				Program_Flash_i,
// RAM Interface
input		wire	[23:0]	Ram_Pointer_Addy_i,		// This is the Pointer where the Data will be.


input		wire	[7:0]		Mem_Pointer_Data_i,
output	wire	[7:0]		Mem_Pointer_Data_o,
output	wire	[23:0]	Mem_Pointer_Addy_o,
output	wire				Mem_Pointer_RD_WRn_o,
output	wire				Mem_Pointer_OEn_o,
output	wire				Flash_WRn_o,
output	wire				Flash_CSn_o,
output	wire				RAM_CS0n_o,
output	wire				RAM_CS1n_o,
output	wire				PollStatus_o,
output	wire				Process_Done_o

);


reg	[7:0] 	Data_Output;
reg	[7:0]		DATA2WRITE;
reg	[23:0]	Addy_Output;
reg				Poll_Status;
reg				RD_WRn;
reg				OEn;
reg				Flash_WRn;
reg				Flash_CSn;
reg				DirectFlashAddy;
reg	[18:0]	ByteCounter;


assign Flash_WRn_o 				= Flash_WRn;
assign Mem_Pointer_OEn_o		= OEn;
assign Mem_Pointer_RD_WRn_o   = RD_WRn;	// This line is used for the RAM, so the OEn is really the one that counts.
assign Mem_Pointer_Addy_o  = Addy_Output;
assign Mem_Pointer_Data_o  = Data_Output;
assign RAM_CS0n_o 	= ( Mem_Pointer_Addy_o[23:21]  == 3'b000) & Flash_CSn;
assign RAM_CS1n_o 	= ( Mem_Pointer_Addy_o[23:21]  == 3'b001) & Flash_CSn;
assign Flash_CSn_o	= !Flash_CSn;
assign PollStatus_o = Poll_Status;
// Byte Write
localparam		WRITE_ADDY0 = 24'h005555,
               WRITE_ADDY1 = 24'h002AAA,
				   WRITE_ADDY2 = 24'h005555;
					
localparam		ERASE_ADDY0 = 24'h005555,
               ERASE_ADDY1 = 24'h002AAA,
				   ERASE_ADDY2 = 24'h005555,
					ERASE_ADDY3 = 24'h005555,
               ERASE_ADDY4 = 24'h002AAA,
				   ERASE_ADDY5 = 24'h005555;					

// Byte Write					
localparam		WRITE_DATA0 = 8'hAA,
					WRITE_DATA1 = 8'h55,
					WRITE_DATA2 = 8'hA0;

// Full Erase					
localparam		ERASE_DATA0 = 8'hAA,
					ERASE_DATA1 = 8'h55,
					ERASE_DATA2 = 8'h80,
					ERASE_DATA3 = 8'hAA,
					ERASE_DATA4 = 8'h55,
					ERASE_DATA5 = 8'h10;
					
					
localparam		STATE_IDLE		  	= 5'b0_0000,
					STATE_ERASE_ST0  	= 5'b0_0001,
					STATE_ERASE_ST1  	= 5'b0_0011,
					STATE_ERASE_ST2  	= 5'b0_0010,
					STATE_ERASE_ST3  	= 5'b0_0110,
					STATE_ERASE_ST4  	= 5'b0_0111,
					STATE_ERASE_ST5  	= 5'b0_0101,
					STATE_ERASE_ST6  	= 5'b0_0100,
					STATE_WRITE_BT0  	= 5'b0_1100,
					STATE_WRITE_BT1  	= 5'b0_1101,
					STATE_WRITE_BT2  	= 5'b0_1111,
					STATE_WRITE_BT3  	= 5'b0_1110,
					STATE_WRITE_BT4  	= 5'b0_1010,
					STATE_POLL_ST0   	= 5'b0_1011,
					STATE_POLL_ST1   	= 5'b0_1001,
					STATE_POLL_ST2   	= 5'b0_1000,
					STATE_POLL_ST3   	= 5'b1_1000,
					STATE_POLL_ST4   	= 5'b1_1001,
					STATE_POLL_ST5   	= 5'b1_1011,
					STATE_WR_ST0     	= 5'b1_1010,
					STATE_WR_ST1     	= 5'b1_1110,
					STATE_READ_RAM0  	= 5'b1_1111,
					STATE_READ_RAM1  	= 5'b1_1101,
					STATE_READ_RAM2  	= 5'b1_1100,
					STATE_PRG_FLASH0 	= 5'b1_0100,
					STATE_PRG_FLASH1	= 5'b1_0101,
					STATE_PRG_FLASH2	= 5'b1_0111,
					STATE_PRG_FLASH3	= 5'b1_0110,
					STATE_WRITE_DLY0	= 5'b1_0010,	
					STATE_WRITE_DLY1  = 5'b1_0011,
					STATE_WRITE_DLY2  = 5'b1_0001,
					STATE_DONE       	= 5'b1_0000;

	//// DEBUG ChipScope
/*
wire [63:0] ScopeIn;
wire			Trigger;

assign Trigger = Erase_Flash_i | Program_Flash_i;

assign ScopeIn[23:0 ] = Mem_Pointer_Addy_o;
assign ScopeIn[31:24] = Mem_Pointer_Data_i;
assign ScopeIn[39:32] = Mem_Pointer_Data_o;
assign ScopeIn[40] = Mem_Pointer_RD_WRn_o;
assign ScopeIn[41] = Mem_Pointer_OEn_o;
assign ScopeIn[42] = Flash_WRn_o;
assign ScopeIn[43] = Flash_CSn_o;
assign ScopeIn[44] = RAM_CS0n_o;
assign ScopeIn[45] = RAM_CS1n_o;
assign ScopeIn[46] = PollStatus_o;
assign ScopeIn[47] = Process_Done_o;
assign ScopeIn[58:48] = 0;
assign ScopeIn[63:59] = StateMachine;

ChipScope ChipSCOPE(
		.acq_clk(Clk_i),        // acq_clk.clk
		.acq_data_in(ScopeIn),    //     tap.acq_data_in
		.acq_trigger_in(Trigger),  //        .acq_trigger_in
		.trigger_in(Trigger)
	);					
*/
					
					
initial
begin
	StateMachine = STATE_IDLE;
	OEn = 1'b1;
	Flash_WRn = 1'b1;
	Flash_CSn = 1'b1;
	RD_WRn = 1'b1;
end
reg	[8:0]		CountDown;

reg	[3:0]		ProcessDone;

reg	[4:0]		StateMachine;
reg	[4:0]		StateStateMachine;

assign Process_Done_o = ProcessDone[3];

always @ (negedge Clk_i)					
begin
	if (Rst_i) begin
		StateMachine <= STATE_IDLE;
		OEn			 <= 1'b1;
		Flash_WRn	 <= 1'b1;
		Flash_CSn		<= 1'b1;
		RD_WRn			<= 1'b1;
	end
	else begin
	
	ProcessDone <= ProcessDone << 1'b1;
	
	case( StateMachine )
	
		STATE_IDLE: begin
			if (Erase_Flash_i) begin
				StateMachine <= STATE_ERASE_ST0;
			end
			else begin
				if ( Program_Flash_i ) begin
					StateMachine <= STATE_PRG_FLASH0;
					ByteCounter	<= 19'b000_0000_0000_0000_0000;
				end
				else begin
					StateMachine <= STATE_IDLE;
					OEn			 <= 1'b1;	// This is the strobe to get the Data read from the RAM
					Flash_WRn	 <= 1'b1;	// This is the strobe to get the Data Written for the Flash
					Flash_CSn	 <= 1'b1;
				end
			end
		end 
	
		///////////////////////////
		// ENTIRE FLASH ERASE
		///////////////////////////	
		STATE_ERASE_ST0: begin
			Addy_Output <=	ERASE_ADDY0; //0x5555
			Data_Output <= ERASE_DATA0; //0xAA
			Flash_CSn <= 1'b0;
			RD_WRn <= 1'b0;
			StateMachine <= STATE_WR_ST0;			
			StateStateMachine <= STATE_ERASE_ST1;
		end

		STATE_ERASE_ST1: begin
			Addy_Output <=	ERASE_ADDY1; //0x2AAA
			Data_Output <= ERASE_DATA1; //0x55
			StateMachine <= STATE_WR_ST0;			
			StateStateMachine <= STATE_ERASE_ST2;
		end
	
		STATE_ERASE_ST2: begin
			Addy_Output <=	ERASE_ADDY2; //0x5555
			Data_Output <= ERASE_DATA2; //0x80
			StateMachine <= STATE_WR_ST0;			
			StateStateMachine <= STATE_ERASE_ST3;
		end
	
		STATE_ERASE_ST3: begin
			Addy_Output <=	ERASE_ADDY3; //0x5555
			Data_Output <= ERASE_DATA3; //0xAA
			StateMachine <= STATE_WR_ST0;			
			StateStateMachine <= STATE_ERASE_ST4;
		end
	
		STATE_ERASE_ST4: begin
			Addy_Output <=	ERASE_ADDY4; //0x2AAA
			Data_Output <= ERASE_DATA4; //0x55
			StateMachine <= STATE_WR_ST0;			
			StateStateMachine <= STATE_ERASE_ST5;	
		end
	
		STATE_ERASE_ST5: begin
			Addy_Output <=	ERASE_ADDY5; //0x5555
			Data_Output <= ERASE_DATA5; //0x10
			StateMachine <= STATE_WR_ST0;			
			StateStateMachine <= STATE_ERASE_ST6;
		end

		STATE_ERASE_ST6: begin
			Flash_CSn <= 1'b1;
			RD_WRn <= 1'b1;
			StateMachine <= STATE_POLL_ST0;
			StateStateMachine <= STATE_DONE;
		end
	
		///////////////////////////
		// FLASH WRITE BYTE
		///////////////////////////
		STATE_WRITE_BT0: begin
			Addy_Output <=	WRITE_ADDY0; //0x5555
			Data_Output <= WRITE_DATA0; //0xAA
			Flash_CSn <= 1'b0;
			RD_WRn <= 1'b0;			
			StateMachine <= STATE_WR_ST0;			
			StateStateMachine <= STATE_WRITE_BT1;	
		end
	
		STATE_WRITE_BT1: begin
			Addy_Output <=	WRITE_ADDY1; //0x2AAA
			Data_Output <= WRITE_DATA1; //0x55
			StateMachine <= STATE_WR_ST0;			
			StateStateMachine <= STATE_WRITE_BT2;	
		end
	
		STATE_WRITE_BT2: begin
			Addy_Output <=	WRITE_ADDY2; //0x5555
			Data_Output <= WRITE_DATA2; //0x10
			StateMachine <= STATE_WR_ST0;			
			StateStateMachine <= STATE_WRITE_BT3;
		end
	
		STATE_WRITE_BT3: begin
			Addy_Output <=	(24'hF80000 + ByteCounter); //
			Data_Output <= DATA2WRITE;
			StateMachine <= STATE_WR_ST0;
			StateStateMachine <= STATE_WRITE_BT4;
		end
	
		// Go Poll for 20us For EveryByte Writen
		STATE_WRITE_BT4: begin
			Flash_CSn <= 1'b1;
			RD_WRn <= 1'b1;			
			StateMachine <= STATE_WRITE_DLY0;
			StateStateMachine <= STATE_PRG_FLASH2;		
		end
	
		///////////////////////////
		// POLLING Happens HERE
		///////////////////////////
		STATE_POLL_ST0: begin
			Addy_Output <=	24'hFFFFFF;
			Flash_CSn	<= 1'b0;
			StateMachine <= STATE_POLL_ST1;			
		end
	
		STATE_POLL_ST1: begin
			OEn			 <= 1'b0;
			StateMachine <= STATE_POLL_ST2;					
		end
	
		STATE_POLL_ST2: begin
			Poll_Status  <= Mem_Pointer_Data_i[7];
			StateMachine <= STATE_POLL_ST3;
		end
	
		STATE_POLL_ST3: begin
			OEn			 <= 1'b1;		
			Flash_CSn 	 <= 1'b1;
			StateMachine <= STATE_POLL_ST4;			
		end
	
		STATE_POLL_ST4: begin
			if (Poll_Status)
				StateMachine <= STATE_POLL_ST5;
			else 
				StateMachine <= STATE_POLL_ST0;
		end
	
		// if we reached here, it is because the Polling is done.
		STATE_POLL_ST5: begin
				StateMachine <= StateStateMachine;
		end
	
		//////////////////////////////
		// Write Pulse
		//////////////////////////////
		STATE_WR_ST0: 	begin
			Flash_WRn <= 1'b0;
			StateMachine <= STATE_WR_ST1;
		end
	
		STATE_WR_ST1: begin
			Flash_WRn    <= 1'b1;
			StateMachine <= StateStateMachine;
		end
		
		//////////////////////////////
		// READ RAM BYTES
		//////////////////////////////
		STATE_READ_RAM0:	begin
			Addy_Output <=	( Ram_Pointer_Addy_i + ByteCounter ); 
			OEn			<= 1'b0;
			StateMachine <= STATE_READ_RAM1;
		end
	
		STATE_READ_RAM1:	begin
			DATA2WRITE	<= Mem_Pointer_Data_i;
			StateMachine <= STATE_READ_RAM2;			
		end
	
		STATE_READ_RAM2:	begin
			OEn			<= 1'b1;
			StateMachine <= StateStateMachine;
		end
	
		//////////////////////////////
		// PROGRAM FLASH STATES
		//////////////////////////////	
		// Read RAM
		STATE_PRG_FLASH0:	begin
			StateMachine <= STATE_READ_RAM0;
			StateStateMachine <= STATE_PRG_FLASH1;
	
		end
		// Write BYTE
		STATE_PRG_FLASH1:	begin 
			StateMachine <= STATE_WRITE_BT0;
		end
	
		// Increment Pointer1
		STATE_PRG_FLASH2:	begin
			ByteCounter <= ByteCounter + 19'b000_0000_0000_0000_0001;
			StateMachine <= STATE_PRG_FLASH3;			
		end
	
		STATE_PRG_FLASH3:	begin 
			if (ByteCounter)
				StateMachine <= STATE_PRG_FLASH0;
			else 
				StateMachine <= STATE_DONE;
		end
		
		//////////////////////////////
		// PROGRAM FLASH STATES
		//////////////////////////////		
		STATE_WRITE_DLY0: begin
			CountDown <= 9'd290;
			StateMachine <= STATE_WRITE_DLY1;		
		end

		STATE_WRITE_DLY1: begin
			if (CountDown)
				CountDown <= CountDown - 9'b0_0000_0001;
			else
				StateMachine <= StateStateMachine;		
		
		end

		STATE_WRITE_DLY2: begin
		
		
		end
		
		
		STATE_DONE: begin 
				ProcessDone <= 4'b1111;
				StateMachine <= STATE_IDLE;	
		end
	
	
		default: begin 
				StateMachine <= STATE_IDLE;		
		end
	
	endcase 
	
	end

end


endmodule
