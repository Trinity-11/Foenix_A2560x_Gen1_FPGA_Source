wire 	[31:0]		VGE_VRAM_B_DQ_o;
wire 	[3:0]		VGE_VRAM_B_BEn_o;
wire 	[19:0]		VGE_VRAM_B_Addy_o;
wire   				VGE_VRAM_B_OEn_o;
wire				VGE_VRAM_B_WEn_o;

