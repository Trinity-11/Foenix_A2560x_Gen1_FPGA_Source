	.TOS_Graph_Target_Addy_Start_o( EmuTOS_Target_Addy_Start ),
	.TOS_Graph_Target_Addy_Stop_o( EmuTOS_Target_Addy_Stop  ),

	.VideoClock_i( VideoClock_B_i ),
	.HBlanking_i( HBlanking_B_i ),
	.VBlanking_i( VBlanking_B_i ),
	.VBlanking_2LinePrecharge_i( VGE_Engine_VBlanking_B1L_i ),
	.HLineCount_i( HLineCount_B_i ),
	.HPixelCount_i( HPixelCount_B_i ),
	.SOF_i( SOF_Channel_B_i ),

	.TOS_GRAPH_RGB_o( TOSGRAPH_RGB_o )
);
*/
assign EmuTOS_Target_Enable = 1'b0;
assign EmuTOS_Target_Load = 1'b0;
assign EmuTOS_Target_Addy_Start = 32'h0000_0000;
assign EmuTOS_Target_Addy_Stop = 32'h0000_0000;
assign DataOut_EMUTOS_Graph_32 = 32'h0000_0000;


endmodule
