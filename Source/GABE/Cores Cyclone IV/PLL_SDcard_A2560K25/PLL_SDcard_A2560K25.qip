set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "PLL_SDcard_A2560K25_bb.v"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "PLL_SDcard_A2560K25.ppf"]
